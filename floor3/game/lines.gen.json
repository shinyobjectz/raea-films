 "vm1": {
  "seconds": 25.783,
  "captions": [
   {
    "text": "Hey.",
    "t0": 0,
    "t1": 0.72
   },
   {
    "text": "It's Dana, from I.T.",
    "t0": 0.72,
    "t1": 3.04
   },
   {
    "text": "If you're hearing this, you're still on three.",
    "t0": 3.04,
    "t1": 6.48
   },
   {
    "text": "Okay.",
    "t0": 6.48,
    "t1": 7.52
   },
   {
    "text": "One rule.",
    "t0": 7.52,
    "t1": 9.04
   },
   {
    "text": "Don't stand still.",
    "t0": 9.04,
    "t1": 11.2
   },
   {
    "text": "When the floor thinks nobody's here,",
    "t0": 11.2,
    "t1": 13.76
   },
   {
    "text": "it goes to sleep.",
    "t0": 13.76,
    "t1": 15.36
   },
   {
    "text": "And when it sleeps, something else wakes up.",
    "t0": 15.36,
    "t1": 19.52
   },
   {
    "text": "Get to the east stairwell.",
    "t0": 19.52,
    "t1": 21.6
   },
   {
    "text": "I'll leave you messages on the way.",
    "t0": 21.6,
    "t1": 24.08
   },
   {
    "text": "Keep moving.",
    "t0": 24.08,
    "t1": 25.6
   }
  ],
